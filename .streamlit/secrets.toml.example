# Copy to .streamlit/secrets.toml locally; never commit that file.
VOICE_WEB_URL = "http://localhost:3000/streamlit"
ENABLE_VOICE_SERVICES = "0"
LIVEKIT_URL = "wss://your-project.livekit.cloud"
LIVEKIT_API_KEY = ""
LIVEKIT_API_SECRET = ""
# Only a verified OIDC email in this server-side allowlist may request voice.
ALLOWED_EMAILS = "owner@example.invalid"

[auth]
# Replace both origin and callback in the provider console before deployment.
redirect_uri = "https://YOUR-COACH.streamlit.app/oauth2callback"
cookie_secret = ""
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
